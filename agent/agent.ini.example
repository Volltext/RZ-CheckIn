; Konfiguration des Reader-Agenten. Nach Windows kopieren als agent.ini und anpassen.
; Jeder Wert kann auch per Umgebungsvariable RZ_AGENT_<NAME IN GROSSBUCHSTABEN>
; überschrieben werden, z.B. RZ_AGENT_API_KEY (praktisch, um den Key nicht im Klartext
; in der Datei abzulegen).

[agent]
; URL des RZ-CheckIn-Backends (interner Server, siehe README).
server_url = https://rz-checkin.intern.example.org

; Sprechende ID dieses Kiosk-PCs, muss im Admin-Bereich unter "Agenten" angelegt sein.
agent_id = kiosk1

; API-Key, der beim Anlegen des Agenten im Admin-Bereich einmalig angezeigt wird.
; Nicht im Klartext committen -- besser über RZ_AGENT_API_KEY setzen oder die Datei
; mit eingeschränkten NTFS-Rechten versehen.
api_key = BITTE-AUS-DEM-ADMIN-BEREICH-EINTRAGEN

; Referenzhardware: NFC-Kartenleser USB ACR122U-A9 (RFID). Vendor:Product 072f:2200
; (ACS ACR122U) -- fest angeben statt nur "usb", damit der Agent nicht versehentlich ein
; anderes USB-Gerät anspricht. Windows-Treiber-Setup siehe agent/README.md Abschnitt 1.
reader = usb:072f:2200

; Alternative: PN532-Board als USB-Seriell (UART, meldet sich als COM-Port):
;   reader = tty:COM3:pn532
; Alternative: irgendein von nfcpy unterstützter USB-Leser (Auto-Erkennung):
;   reader = usb

; Sekunden zwischen zwei Heartbeats (siehe /health/agent/{agent_id} für die
; PRTG-Überwachung).
heartbeat_interval = 30

; Sekunden zwischen zwei Versuchen, den Offline-Puffer zu leeren.
spool_flush_interval = 15

; Mindestabstand zwischen zwei Reads, damit eine liegen bleibende Karte nicht
; mehrfach pro Sekunde ausgelesen wird (zusätzlich zur serverseitigen Entprellung).
scan_cooldown = 1.0

; TLS-Prüfung. false nur für Testaufbauten ohne gültiges Zertifikat verwenden.
verify_tls = true
; Pfad zu einem eigenen CA-Bundle, falls der Server ein internes Zertifikat nutzt.
; ca_bundle = C:\pfad\zur\firmen-ca.pem

; Dateien im Arbeitsverzeichnis des Agenten (bei nssm i.d.R. der Installationsordner).
spool_path = agent_spool.jsonl
log_path = reader_agent.log

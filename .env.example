# Kopieren nach .env und anpassen. Alle Variablen sind optional und haben sinnvolle
# Defaults für die lokale Entwicklung (siehe app/config.py).

# Pfad zur SQLite-Datenbankdatei
RZ_DATABASE_PATH=./data/rz-checkin.db

# Zufälliger, geheimer Wert zum Signieren der Admin-Session-Cookies.
# Für den Betrieb unbedingt setzen (z.B. `openssl rand -hex 32`).
RZ_SESSION_SECRET=bitte-aendern-dev-only-secret

# Bootstrap eines ersten Admin-Users, falls beim Start noch keiner existiert.
# Danach kann das Passwort im Admin-Bereich geändert werden.
RZ_ADMIN_USER=admin
RZ_ADMIN_PASSWORD=
# Ist RZ_ADMIN_PASSWORD leer, wird beim Erststart automatisch ein Admin mit zufälligem
# Passwort angelegt (sichtbar in den Logs) -- praktisch für ein "einfach starten und
# nutzen" ohne weitere Einrichtung. Für kontrollierte Deployments auf false setzen.
RZ_ADMIN_AUTO_BOOTSTRAP=true

# Entprellung: gleiche UID innerhalb dieses Fensters wird ignoriert (Sekunden)
RZ_SCAN_DEBOUNCE_SECONDS=5

# Schwellwert, ab dem ein Agent als "offline" gilt (Sekunden seit letztem Heartbeat)
RZ_AGENT_OFFLINE_THRESHOLD_SECONDS=90

# Aufbewahrungsfrist für Log-Einträge in Tagen (Standard 2 Jahre)
RZ_RETENTION_DAYS=730

# Startwert fürs automatische Auschecken (falls jemand das Aus-Scannen vergisst), in
# Stunden -- 0 = deaktiviert. Danach im Admin-Bereich unter "Einstellungen" zur Laufzeit
# änderbar, ohne Neustart (siehe app/services/settings.py).
RZ_AUTO_CHECKOUT_DEFAULT_HOURS=12

# Wie oft der Hintergrund-Task prüft, ob jemand die Frist überschritten hat (Sekunden)
RZ_AUTO_CHECKOUT_CHECK_INTERVAL_SECONDS=300

# Kommagetrennte Liste von IPs/CIDRs, die auf /admin zugreifen dürfen.
# Leer = keine zusätzliche Einschränkung (nur Login-Schutz).
RZ_ADMIN_IP_ALLOWLIST=

# Optionaler Titel, der im Kiosk-Header angezeigt wird
RZ_SITE_TITLE=Rechenzentrum Check-in
